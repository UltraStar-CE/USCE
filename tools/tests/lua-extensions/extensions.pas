procedure Check(B:boolean;const M:string);begin if not B then raise Exception.Create(M);end;
procedure Run(P:TLuaPlugin;const S:UTF8String);
begin if luaL_dostring(P.LuaState,PChar(S))<>0 then raise Exception.Create(string(lua_tostring(P.LuaState,-1)));end;
begin
 SetMultiByteConversionCodePage(CP_UTF8);
 SoundPath:=Path('.');Ini:=TIni.Create;Backend:=TBackend.Create;MediaManager.Clear;MediaManager.Add(Backend);Ini.SfxVolume:=37;InitializeSound;
 LuaCore:=TLuaCore.Create;LuaCore.RegisterModule('Music',ULuaMusic_Lib_f);RegisterSongHooks;
 E:=Pointer(LuaCore.GetEventByName('ScreenSong.ParseInput'));RegisterSongHooks;
 Check(E=Pointer(LuaCore.GetEventByName('ScreenSong.ParseInput')),'idempotent hooks');
 LuaCore.LoadPlugin(Path(UTF8String(ParamStr(1))));P:=LuaCore.GetPluginById(0);Check(P.Status=psRunning,'plugin loaded');
 LuaCore.LoadPlugin(Path(UTF8String(ParamStr(2))));Q:=LuaCore.GetPluginById(1);Check(Q.Status=psRunning,'second plugin');
 Run(P,'h=Usdx.Music.OpenSound("./fixture.ogg"); Usdx.Music.PlaySound(h)');
 Check((Played=1) and (Abs(LastVolume-0.37)<0.001),'play and configured volume');
 Run(Q,'assert(not pcall(Usdx.Music.PlaySound,1)); assert(not pcall(Usdx.Music.UnloadSound,1))');
 Run(P,'assert(not pcall(Usdx.Music.LoadSound,"./missing.ogg")); Usdx.Music.UnloadSound(h); assert(not pcall(Usdx.Music.PlaySound,h)); h2=Usdx.Music.LoadSound("./fixture.ogg"); assert(h2~=h)');
 Check((Freed=1) and (Stopped=1),'explicit unload');
 CatSongs:=TCatSongs.Create;SetLength(CatSongs.Song,1);CatSongs.Song[0]:=TSong.Create;CatSongs.Song[0].Visible:=true;CatSongs.ResetVisibleIndexCache;
 ScreenSongMenu:=TMenuStub(TMenuStub.NewInstance);ScreenSongJumpto:=TScreenSongJumpto(TScreenSongJumpto.NewInstance);
 ScreenSong:=TScreenSong(TScreenSong.NewInstance);ScreenSong.eParseInput:=LuaCore.GetEventByName('ScreenSong.ParseInput');
 ScreenSong.eSongSelected:=LuaCore.GetEventByName('ScreenSong.SongSelected');
 Check(ScreenSong.ParseInput(SDLK_F9,65,true),'hook consumed key');
 Run(P,'assert(last.Key==1073741890 and last.Char==65 and last.Down); assert(calls==1)');
 ScreenSongMenu.Visible:=true;Check(ScreenSong.ParseInput(SDLK_F9,65,true),'overlay consumes');
 Run(P,'assert(calls==1)');Check(Overlay=1,'menu precedence');ScreenSongMenu.Visible:=false;
 ScreenSong.eSongSelected.CallHookChain(false);Run(P,'assert(selected==1)');
 ScreenSong.FreeInstance;RegisterSongHooks;
 Check(E=Pointer(LuaCore.GetEventByName('ScreenSong.ParseInput')),'event survives screen replacement');
 ScreenSong:=TScreenSong(TScreenSong.NewInstance);ScreenSong.eParseInput:=LuaCore.GetEventByName('ScreenSong.ParseInput');
 Check(ScreenSong.ParseInput(SDLK_F9,65,false),'hook survives');Run(P,'assert(calls==2 and not last.Down)');
 P.Unload;Check((Freed=2) and (Stopped=2),'plugin unload releases sound');
 Run(Q,'h=Usdx.Music.LoadSound("./fixture.ogg"); assert(h>2)');LuaMusicReleaseAll;
 Run(Q,'assert(not pcall(Usdx.Music.PlaySound,h))');Check(Freed=3,'shutdown releases sound');Q.Unload;
 ScreenSong.FreeInstance;ScreenSong:=nil;ScreenSongMenu.FreeInstance;ScreenSongMenu:=nil;ScreenSongJumpto.FreeInstance;ScreenSongJumpto:=nil;
 CatSongs.Free;CatSongs:=nil;
 Writeln('PASS: actual Lua modules, cross-plugin handles, unload, stale IDs, missing files, SFX volume, input payload, overlay priority and persistent hooks');
end.
