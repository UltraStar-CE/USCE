program Identity;
{$mode delphi}{$codepage utf8}
uses Classes,SysUtils,USong,USongIdentity,UPath,UTextEncoding;
var LibrarySongs:TList;A,B,C,D,X,Y:TSong;Root:IPath;Original,Expected,OldBytes:RawByteString;Failed:boolean;I:integer;
procedure Check(Value:boolean;const Msg:string);begin if not Value then raise Exception.Create(Msg);end;
procedure WriteFile(const FilePath:IPath;const Value:RawByteString);
var S:TBinaryFileStream;begin S:=TBinaryFileStream.Create(FilePath,fmCreate);try S.WriteBuffer(Value[1],Length(Value));finally S.Free;end;end;
function ReadFile(const FilePath:IPath):RawByteString;
var S:TBinaryFileStream;begin S:=TBinaryFileStream.Create(FilePath,fmOpenRead);try SetLength(Result,S.Size);S.ReadBuffer(Result[1],Length(Result));finally S.Free;end;end;
function Song(const Filename,Artist,Title:UTF8String):TSong;
begin Result:=TSong.Create;Result.Path:=Root;Result.FileName:=Path(Filename);Result.Artist:=Artist;Result.Title:=Title;Result.Encoding:=encUTF8;LibrarySongs.Add(Result);end;
begin
 SetMultiByteConversionCodePage(CP_UTF8);Root:=Path(UTF8String(ParamStr(1))).Append(UTF8String('charts-ä'));Root.CreateDirectory;LibrarySongs:=TList.Create;
 A:=Song('one-ä.txt','Grüße','Same');B:=Song('two.txt','Grüße','Same');C:=Song('three.txt','Other','Existing');
 Check(FindDuplicateIdentity(LibrarySongs,X,Y),'find pair');Check((X<>Y) and (X.Artist=Y.Artist),'distinct files');
 Original:=RawByteString(UTF8_BOM)+'#TITLE:Same'+#13#10+'#ARTIST:Grüße'+#13#10+'#X-KEEP:  abc  '+#13#10+#13#10+': 0 4 60 Text'+#10+'E';
 WriteFile(A.Path.Append(A.FileName),Original);
 Failed:=false;try RenameSongIdentity(LibrarySongs,A,'Other','Existing');except Failed:=true;end;
 Check(Failed and (ReadFile(A.Path.Append(A.FileName))=Original),'reject conflict elsewhere without write');
 Failed:=false;try RenameSongIdentity(LibrarySongs,A,'Grüße ','Same ');except Failed:=true;end;Check(Failed,'trimmed collision rejected');
 Failed:=false;try RenameSongIdentity(LibrarySongs,A,' ','Name');except Failed:=true;end;Check(Failed,'reject empty');
 Failed:=false;try RenameSongIdentity(LibrarySongs,A,'Valid','bad'+#10+'#BPM:999');except Failed:=true;end;Check(Failed,'reject line break');
 RenameSongIdentity(LibrarySongs,A,'Grüße','Unique');Expected:=StringReplace(Original,'#TITLE:Same','#TITLE:Unique',[]);
 Check(ReadFile(A.Path.Append(A.FileName))=Expected,'only header bytes change; BOM/newlines/unknown headers/chart intact');
 Check(ReadFile(Root.Append('one-ä.txt.usce-backup-1'))=Original,'exact backup');Check(not FindDuplicateIdentity(LibrarySongs,X,Y),'resolved');
 RenameSongIdentity(LibrarySongs,A,'Changed','Unique');Check(ReadFile(Root.Append('one-ä.txt.usce-backup-1'))=Original,'original backup kept');
 Check(ReadFile(Root.Append('one-ä.txt.usce-backup-2'))=Expected,'second edit distinct backup');
 D:=Song('four.txt','Grüße','Same');Check(FindDuplicateIdentity(LibrarySongs,X,Y),'next duplicate found');D.Title:='Different';
 D:=Song('two.txt','Grüße','Same');Check(not FindDuplicateIdentity(LibrarySongs,X,Y),'same physical pathname is not distinct song');
 D.Artist:='ab';D.Title:='c';C.Artist:='a';C.Title:='bc';Check(not FindDuplicateIdentity(LibrarySongs,X,Y),'key boundaries');
 Original:='#TITLE:Legacy'+#10+'#ARTIST:Gr'+#$FC+#$DF+'e'+#10+'#X-KEEP:foo'+#10+': 0 4 60 '+#$FC+#10+'E'+#10;
 A.Encoding:=encCP1252;WriteFile(A.Path.Append(A.FileName),Original);
 RenameSongIdentity(LibrarySongs,A,'Grüße','Legacy new');Expected:=StringReplace(Original,'#TITLE:Legacy','#TITLE:Legacy new',[]);
 Check(ReadFile(A.Path.Append(A.FileName))=Expected,'legacy bytes preserved');
 Failed:=false;try RenameSongIdentity(LibrarySongs,A,'歌','Title');except Failed:=true;end;Check(Failed,'unrepresentable legacy name rejected');
 Check(ReadFile(A.Path.Append(A.FileName))=Expected,'failed edit preserves file');
 A.Encoding:=encAuto;RenameSongIdentity(LibrarySongs,A,'Grüße','Auto legacy');
 Check(Pos(RawByteString('Gr'+#$FC+#$DF+'e'),ReadFile(A.Path.Append(A.FileName)))>0,'auto encoding preserves legacy bytes');
 for I:=0 to LibrarySongs.Count-1 do TSong(LibrarySongs[I]).Free;LibrarySongs.Free;
 Writeln('PASS: duplicate pairs, all-library collisions, repeated resolution, same-file entries, key boundaries, UTF8/legacy encoding and byte-preserving header edits/backups');
end.
