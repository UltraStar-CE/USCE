# RmlUi 6.1 leaves the last child's transform active during parent mask composition.
# Restore the parent's transform in a generated copy, keeping the pinned source untouched.
get_target_property(core_directory rmlui_core SOURCE_DIR)
file(READ "${core_directory}/ElementEffects.cpp" effects)
set(needle "else if (render_stage == RenderStage::Exit)\n\t{\n\t\tif (!filters.empty() || !mask_images.empty())\n\t\t{\n")
string(FIND "${effects}" "${needle}" position)
if(position EQUAL -1)
  message(FATAL_ERROR "Review the RmlUi parent-effect transform fix after updating the dependency")
endif()
string(REPLACE "${needle}" "${needle}\t\t\tElementUtilities::ApplyTransform(*element);\n" effects "${effects}")
# The generated translation unit retains the original include paths and copyright.
string(REGEX REPLACE "#include \"([^\"]+)\"" "#include \"${core_directory}/\\1\"" effects "${effects}")
set(generated_effects "${CMAKE_CURRENT_BINARY_DIR}/embedded-effects.cpp")
file(WRITE "${generated_effects}" "${effects}")
get_target_property(core_sources rmlui_core SOURCES)
set(patched_sources)
set(replaced FALSE)
foreach(source IN LISTS core_sources)
  if(source STREQUAL "ElementEffects.cpp" OR source STREQUAL "${core_directory}/ElementEffects.cpp")
    list(APPEND patched_sources "${generated_effects}")
    set(replaced TRUE)
  elseif(IS_ABSOLUTE "${source}" OR source MATCHES "^\\$<")
    list(APPEND patched_sources "${source}")
  else()
    list(APPEND patched_sources "${core_directory}/${source}")
  endif()
endforeach()
if(NOT replaced)
  message(FATAL_ERROR "Could not locate the pinned RmlUi effect source")
endif()
set_property(TARGET rmlui_core PROPERTY SOURCES "${patched_sources}")
