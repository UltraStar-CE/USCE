# A repeated element's attributes are siblings of its data-for placeholder.
# Prune removed elements before evaluating those same-depth attribute bindings.
get_target_property(core_directory rmlui_core SOURCE_DIR)
file(READ "${core_directory}/DataViewDefault.cpp" views)
set(needle "DataViewFor::DataViewFor(Element* element) : DataView(element, 0) {}")
string(FIND "${views}" "${needle}" position)
if(position EQUAL -1)
  message(FATAL_ERROR "Review the RmlUi repeated-view ordering fix after updating the dependency")
endif()
string(REPLACE "${needle}" "DataViewFor::DataViewFor(Element* element) : DataView(element, -1000) {}" views "${views}")
# The generated translation unit retains the original include paths and copyright.
string(REGEX REPLACE "#include \"([^\"]+)\"" "#include \"${core_directory}/\\1\"" views "${views}")
set(generated_views "${CMAKE_CURRENT_BINARY_DIR}/embedded-views.cpp")
file(WRITE "${generated_views}" "${views}")
get_target_property(core_sources rmlui_core SOURCES)
set(patched_sources)
set(replaced FALSE)
foreach(source IN LISTS core_sources)
  if(source STREQUAL "DataViewDefault.cpp" OR source STREQUAL "${core_directory}/DataViewDefault.cpp")
    list(APPEND patched_sources "${generated_views}")
    set(replaced TRUE)
  elseif(IS_ABSOLUTE "${source}" OR source MATCHES "^\\$<")
    list(APPEND patched_sources "${source}")
  else()
    list(APPEND patched_sources "${core_directory}/${source}")
  endif()
endforeach()
if(NOT replaced)
  message(FATAL_ERROR "Could not locate the pinned RmlUi data-view source")
endif()
set_property(TARGET rmlui_core PROPERTY SOURCES "${patched_sources}")
