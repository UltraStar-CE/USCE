# Native surfaces query document Regions before painting. Keep RmlUi's projected
# bounds current after layout, instead of waiting for the first render traversal.
get_target_property(core_directory rmlui_core SOURCE_DIR)
file(READ "${core_directory}/Context.cpp" context)
set(needle "\t// Release any documents that were unloaded during the update.\n\tReleaseUnloadedDocuments();\n\n\treturn true;")
string(FIND "${context}" "${needle}" position)
if(position EQUAL -1)
  message(FATAL_ERROR "Review the RmlUi layout-transform preparation after updating the dependency")
endif()
set(replacement "\t// Release any documents that were unloaded during the update.\n\tReleaseUnloadedDocuments();\n\n\t// Prepare projected bounds without issuing any render commands.\n\tconst auto prepare_transforms = [](auto&& self, Element* element) -> void {\n\t\telement->UpdateAbsoluteOffsetAndRenderBoxData();\n\t\telement->UpdateTransformState();\n\t\tfor (int i = 0; i < element->GetNumChildren(true); ++i)\n\t\t\tself(self, element->GetChild(i));\n\t};\n\tprepare_transforms(prepare_transforms, root.get());\n\n\treturn true;")
string(REPLACE "${needle}" "${replacement}" context "${context}")
# Preserve the dependency's copyright and resolve its original private includes.
string(REGEX REPLACE "#include \"([^\"]+)\"" "#include \"${core_directory}/\\1\"" context "${context}")
set(generated_context "${CMAKE_CURRENT_BINARY_DIR}/embedded-context.cpp")
file(WRITE "${generated_context}" "${context}")
get_target_property(core_sources rmlui_core SOURCES)
set(patched_sources)
set(replaced FALSE)
foreach(source IN LISTS core_sources)
  if(source STREQUAL "Context.cpp" OR source STREQUAL "${core_directory}/Context.cpp")
    list(APPEND patched_sources "${generated_context}")
    set(replaced TRUE)
  elseif(IS_ABSOLUTE "${source}" OR source MATCHES "^\\$<")
    list(APPEND patched_sources "${source}")
  else()
    list(APPEND patched_sources "${core_directory}/${source}")
  endif()
endforeach()
if(NOT replaced)
  message(FATAL_ERROR "Could not locate the pinned RmlUi context source")
endif()
set_property(TARGET rmlui_core PROPERTY SOURCES "${patched_sources}")
