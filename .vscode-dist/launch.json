{
  "version": "0.2.0",
  "inputs": [
    {
      "id": "songpath",
      "type": "promptString",
      "description": "Path to songs folder",
      "default": "songs"
    }
  ],
  "configurations": [
    {
      "name": "[Windows] USCE (GDB)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/game/usce.exe",
      "args": [
        "-songpath",
        "${input:songpath}"
      ],
      "cwd": "${workspaceFolder}/game",
      "preLaunchTask": "[any] 2.a make debug",
      "windows": {},
      "MIMode": "gdb",
      "miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe"
    },
    {
      "name": "[Linux] USCE (GDB)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/game/usce",
      "args": [
        "-songpath",
        "${input:songpath}"
      ],
      "cwd": "${workspaceFolder}/game",
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "preLaunchTask": "[any] 2.a make debug",
      "linux": {}
    },
    {
      "name": "[macOS] USCE (LLDB)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/game/usce",
      "args": [
        "-songpath",
        "${input:songpath}"
      ],
      "cwd": "${workspaceFolder}/game",
      "preLaunchTask": "[any] 2.a make debug",
      "osx": {}
    },
    {
      "name": "[macOS] USCE (standalone app, LLDB)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/UltraStar Community Edition.app/Contents/MacOS/usce",
      "args": [
        "-songpath",
        "${input:songpath}"
      ],
      "cwd": "${workspaceFolder}/UltraStar Community Edition.app/Contents/MacOS",
      "preLaunchTask": "[macos] make macos-standalone-app",
      "osx": {}
    }
  ]
}
