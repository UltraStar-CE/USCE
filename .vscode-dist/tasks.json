{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "[helper] autogen",
      "type": "shell",
      "command": "./autogen.sh"
    },
    {
      "label": "[helper] configure",
      "type": "shell",
      "command": "./configure ${input:configureArgs}"
    },
    {
      "label": "[any] 1. autogen & configure",
      "dependsOn": [
        "[helper] autogen",
        "[helper] configure"
      ],
      "dependsOrder": "sequence"
    },
    {
      "label": "[any] 2. make all",
      "type": "shell",
      "command": "make all",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "[any] 2.a make debug",
      "type": "shell",
      "command": "make debug"
    },
    {
      "label": "[any] 2.b make release",
      "type": "shell",
      "command": "make release"
    },
    {
      "label": "[any] 2.c make rebuild",
      "type": "shell",
      "command": "make rebuild"
    },
    {
      "label": "[macos] make macos-app",
      "type": "shell",
      "command": "make macos-app",
      "osx": {
        "group": "build"
      }
    },
    {
      "label": "[macos] make macos-standalone-app",
      "type": "shell",
      "command": "make macos-standalone-app",
      "osx": {
        "group": "build"
      }
    },
    {
      "label": "[macos] make macos-dmg",
      "type": "shell",
      "command": "make macos-dmg",
      "osx": {
        "group": "build"
      }
    },
    {
      "label": "[any] make install",
      "type": "shell",
      "command": "make install"
    },
    {
      "label": "[any] make uninstall",
      "type": "shell",
      "command": "make uninstall"
    },
    {
      "label": "[any] make clean",
      "type": "shell",
      "command": "make clean"
    },
    {
      "label": "[any] make distclean",
      "type": "shell",
      "command": "make distclean"
    },
    {
      "label": "[any] run",
      "type": "process",
      "command": "${workspaceFolder}/game/usce",
      "dependsOn": "[any] 2. make all",
      "problemMatcher": [],
      "windows": {
        "command": "${workspaceFolder}/game/usce.exe"
      },
      "options": {
        "cwd": "${workspaceFolder}/game"
      },
      "args": []
    },
    {
      "label": "[any] run with songpath",
      "type": "process",
      "command": "${workspaceFolder}/game/usce",
      "dependsOn": "[any] 2. make all",
      "problemMatcher": [],
      "windows": {
        "command": "${workspaceFolder}/game/usce.exe"
      },
      "options": {
        "cwd": "${workspaceFolder}/game"
      },
      "args": [
        "-songpath",
        "${input:songpath}"
      ]
    },
    {
      "label": "[macos] run macos-standalone-app",
      "type": "process",
      "command": "open",
      "osx": {},
      "problemMatcher": [],
      "args": [
        "${workspaceFolder}/UltraStar Community Edition.app"
      ]
    }
  ],
  "inputs": [
    {
      "id": "configureArgs",
      "type": "promptString",
      "description": "Arguments for ./configure",
      "default": ""
    },
    {
      "id": "songpath",
      "type": "promptString",
      "description": "Path to songs folder",
      "default": "songs"
    }
  ]
}
