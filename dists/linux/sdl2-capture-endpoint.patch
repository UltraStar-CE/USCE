--- a/src/audio/alsa/SDL_alsa_audio.c
+++ b/src/audio/alsa/SDL_alsa_audio.c
@@ -21,0 +22 @@
+#include "SDL_hints.h"
@@ -766,0 +768,17 @@
+    if (iscapture && this->handle) {
+        const char *tag = SDL_GetHint(SDL_HINT_AUDIO_DEVICE_STREAM_NAME);
+        snd_pcm_info_t *info = NULL;
+        if (tag && SDL_strncmp(tag, "USCE-", 5) == 0 &&
+            ALSA_snd_pcm_info_malloc(&info) >= 0) {
+            if (ALSA_snd_pcm_info(pcm_handle, info) >= 0) {
+                const int card = ALSA_snd_pcm_info_get_card(info);
+                if (card >= 0) {
+                    char card_text[16];
+                    SDL_snprintf(card_text, sizeof(card_text), "%d", card);
+                    SDL_SetHint(tag, card_text);
+                }
+            }
+            ALSA_snd_pcm_info_free(info);
+        }
+    }
+
