+        iscapture && SDL_strncmp(stream_name, "USCE-", 5) == 0 && this->handle;
+    if (verified_capture) {
+        PIPEWIRE_pw_properties_set(props, "node.dont-fallback", "true");
+        PIPEWIRE_pw_properties_set(props, "node.dont-move", "true");
+    }
