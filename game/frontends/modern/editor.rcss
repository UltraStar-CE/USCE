.field-mp3 .field-value { width: 49vw; }
.field-cover { left: 3.75vw; top: 26.6667vh; width: 59vw; }
.field-cover .field-label { width: 9.75vw; }
.field-cover .field-value { width: 49vw; }
.field-background { left: 3.75vw; top: 30vh; width: 59vw; }
.field-background .field-label { width: 9.75vw; }
.field-background .field-value { width: 49vw; }
.field-video { left: 3.75vw; top: 33.3333vh; width: 59vw; }
.field-video .field-label { width: 9.75vw; }
.field-video .field-value { width: 49vw; }
.field-videogap { left: 3.75vw; top: 36.6667vh; width: 19.5vw; }
.field-videogap .field-label { width: 9.75vw; }
.field-videogap .field-value { width: 9.5vw; }
.field-starttag { left: 23.5vw; top: 36.6667vh; width: 19.5vw; }
.field-starttag .field-label { width: 9.75vw; }
.field-starttag .field-value { width: 9.5vw; }
.field-endtag { left: 43.25vw; top: 36.6667vh; width: 19.5vw; }
.field-endtag .field-label { width: 9.75vw; }
.field-endtag .field-value { width: 9.5vw; }
.field-bpm { left: 3.75vw; top: 40vh; width: 19.5vw; }
.field-bpm .field-label { width: 9.75vw; }
.field-bpm .field-value { width: 9.5vw; }
.field-previewstart { left: 23.5vw; top: 40vh; width: 19.5vw; }
.field-previewstart .field-label { width: 9.75vw; }
.field-previewstart .field-value { width: 9.5vw; }
.field-relative { left: 43.25vw; top: 40vh; width: 19.5vw; }
.field-relative .field-label { width: 9.75vw; }
.field-relative .field-value { width: 9.5vw; }
.field-gap { left: 3.75vw; top: 43.3333vh; width: 19.5vw; }
.field-gap .field-label { width: 9.75vw; }
.field-gap .field-value { width: 9.5vw; }
.field-medleystart { left: 23.5vw; top: 43.3333vh; width: 19.5vw; }
.field-medleystart .field-label { width: 9.75vw; }
.field-medleystart .field-value { width: 9.5vw; }
.field-medleyend { left: 43.25vw; top: 43.3333vh; width: 19.5vw; }
.field-medleyend .field-label { width: 9.75vw; }
.field-medleyend .field-value { width: 9.5vw; }
.field-start { left: 3.75vw; top: 49vh; width: 19.5vw; }
.field-start .field-label { width: 9.75vw; }
.field-start .field-value { width: 9.5vw; }
.field-duration { left: 23.5vw; top: 49vh; width: 19.5vw; }
.field-duration .field-label { width: 9.75vw; }
.field-duration .field-value { width: 9.5vw; }
.field-tone { left: 43.25vw; top: 49vh; width: 19.5vw; }
.field-tone .field-label { width: 9.75vw; }
.field-tone .field-value { width: 9.5vw; }
.field-lyric { left: 63.25vw; top: 49vh; width: 33vw; }
.field-lyric .field-label { width: 9.75vw; }
.field-lyric .field-value { width: 23vw; }
.field-volumeaudio { left: 73.75vw; top: 0.833333vh; width: 22.75vw; }
.field-volumeaudio .field-label { width: 12.5vw; }
.field-volumeaudio .field-value { width: 10vw; }
.field-volumemidi { left: 73.75vw; top: 3.33333vh; width: 22.75vw; }
.field-volumemidi .field-label { width: 12.5vw; }
.field-volumemidi .field-value { width: 10vw; }
.field-volumeclick { left: 73.75vw; top: 5.83333vh; width: 22.75vw; }
.field-volumeclick .field-label { width: 12.5vw; }
.field-volumeclick .field-value { width: 10vw; }
.command-undo { left: 64.75vw; top: 43.333333vh; }
.command-previousseq { left: 69.75vw; top: 43.333333vh; }
.command-nextseq { left: 73vw; top: 43.333333vh; }
.command-freestyle { left: 78vw; top: 43.333333vh; }
.command-gold { left: 81.25vw; top: 43.333333vh; }
.command-playonly { left: 86.25vw; top: 43.333333vh; }
.command-playwithnote { left: 89.5vw; top: 43.333333vh; }
.command-playnote { left: 92.75vw; top: 43.333333vh; }

.editor-screen .hidden { display: none; }
.editor-screen .form-row { margin: 0; padding: 0; }

.editor-field button { font-size: 2.000000vh; }
.editor-field button span { margin-top: 0; }
.editor-field.volume button { font-size: 1.750000vh; }
.editor-field svg { opacity: 1; }

.preview-score { position: absolute; left: 1.25vw; top: 2vh; font-size: 1.750000vh; font-weight: bold; color: black; }
.preview-score div { height: 3vh; }
.preview-score span { display: inline; }
.detected-tone { position: absolute; left: 59.5vw; top: 49.166667vh; font-size: 2.000000vh; color: yellow; }

.editor-field button:focus { background-color: transparent; }

/* Match Modern's editor: clear labels over opaque panels, colored value cells. */
.editor-screen .background { width: 100vw; max-width: 100vw; }
.editor-screen .editor-field .field-label { background-color: transparent; color: #555555; }
.editor-screen .editor-field.selected .field-label { background-color: transparent; color: black; font-weight: bold; }
.editor-screen .editor-field .field-value .value { color: white; }
.editor-screen .editor-field.selected .value { font-weight: bold; }
.editor-screen .editor-field.volume .value { font-weight: normal; }
.editor-microphone { background-color: #dddddd; text-align: left; padding-left: 0.5vw; }
.preview-score > div { display: block; width: 100%; }
.editor-counters { left: 3.75vw; font-weight: bold; }
#editor-lyrics-text { position: absolute; left: 0; top: 0; width: 100%; height: 6.666667vh; }

/* Match the legacy renderer's font size and baseline conversion. */
.editor-screen .editor-field .field-label { padding-left: 0.375vw; }
.editor-field button span { margin-top: 0.5vh; }
.editor-microphone { color: black; }
.editor-screen .editor-field.field-starttag .field-value,
.editor-screen .editor-field.field-endtag .field-value { background-color: #999999; }
.header-panel { top: 9vh; left: 2.34375vw; }
