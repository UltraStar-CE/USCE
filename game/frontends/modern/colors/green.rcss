/* Modern green color variant. */
button { background-color: #3bb23be6; }
.buttons button:focus, .secondary:focus, .option-cell button:focus, .about-credits:focus, .about-back:focus { background-color: #76ce76e6; }
.form-label { background-color: #35a135; }
.form-value, .form-row.inline .form-choices { background-color: #3bb23b; }
.form-row.selected .form-label { background-color: #6bba6b; }
.form-row.selected .form-value, .form-row.selected .form-choices { background-color: #76ce76; }
.form-back, .form-extra-command { background-color: #35a135e6; }
.form-back.selected, .form-extra-command.selected { background-color: #6bba6be6; }
.form-back-reflection { decorator: vertical-gradient(#35a13580 #35a13500); }
.form-back-reflection.selected { decorator: vertical-gradient(#6bba6b80 #6bba6b00); }
.description, .where { color: #b4edb4; }
.about-screen .description { color: white; }
.about-panel { background-color: #00ff007b; }
.about-panel-top, .about-panel-bottom { background-color: #00ff00; }
.footer { decorator: image(green-footer.svg); }
.discovery fill { decorator: image(green-bar-left.svg); }
.loading fill { decorator: image(green-bar-right.svg); }

.count-value { background-color: #3bb23be6; }
.player-count.selected .count-label, .player-count.selected .count-value { background-color: #76ce76e6; }

.participant-name { background-color: #3bb23be6; }
.participant-name.selected, .participant-name:focus { background-color: #76ce76e6; }
