/* Modern blue color variant. */
button { background-color: #42a3e7e6; }
.buttons button:focus, .buttons button:hover, .secondary:focus, .secondary:hover, .option-cell button:focus, .option-cell button:hover, .about-credits:focus, .about-credits:hover, .about-back:focus, .about-back:hover { background-color: #7ec5eae6; }
.form-label { background-color: #3c94d0; }
.form-value, .form-row.inline .form-choices { background-color: #42a3e7; }
.form-row.selected .form-label { background-color: #71b2d4; }
.form-row.selected .form-value, .form-row.selected .form-choices { background-color: #7ec5ea; }
.form-back, .form-extra-command { background-color: #3c94d0e6; }
.form-back.selected, .form-extra-command.selected { background-color: #71b2d4e6; }
.form-back-reflection { decorator: vertical-gradient(#3c94d080 #3c94d000); }
.form-back-reflection.selected { decorator: vertical-gradient(#71b2d480 #71b2d400); }
.description, .where { color: #b9e8fd; }
.about-screen .description { color: white; }
.about-panel { background-color: #0097ff7b; }
.about-panel-top, .about-panel-bottom { background-color: #00a8ff; }
.footer { decorator: image(blue-footer.svg); }
.discovery fill { decorator: image(blue-bar-left.svg); }
.loading fill { decorator: image(blue-bar-right.svg); }

.count-value { background-color: #42a3e7e6; }
.player-count.selected .count-label { background-color: #7ec5eae6; }
