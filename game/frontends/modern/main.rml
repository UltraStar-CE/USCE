<rml>
<head><title>Modern main menu</title><link type="text/rcss" href="modern.rcss" /><link type="text/template" href="footer-main.rml" /></head>
<body>
  <svg class="background-edge" src="edge-main.svg" />
  <img class="background" src="../../themes/Modern/[bg-main]blue.jpg" />
  <div class="foreground">
  <img class="heading-icon" src="../../themes/Modern/[icon]main.png" />
  <span class="heading" lang="SING_MENU" />
  <span id="description" class="description" lang="SING_SING_DESC" />
  <div class="buttons">
    <button action="game.sing" focus-text-target="description" focus-text-lang="SING_SING_DESC"><svg src="button.svg" /><span lang="SING_SING" /></button>
    <button action="game.party" focus-text-target="description" focus-text-lang="SING_MULTI_DESC"><svg src="button.svg" /><span lang="SING_MULTI" /></button>
    <button action="statistics.open" focus-text-target="description" focus-text-lang="SING_STATS_DESC"><svg src="button.svg" /><span lang="SING_STATS" /></button>
    <button action="settings.open" focus-text-target="description" focus-text-lang="SING_GAME_OPTIONS_DESC"><svg src="button.svg" /><span lang="SING_SETTINGS" /></button>
  </div>
  <button class="secondary about" action="about.open" focus-text-target="description" focus-text-lang="SING_ABOUT_DESC"><svg src="button.svg" /><span lang="SING_ABOUT" /></button>
  <button class="secondary exit" action="game.exit" focus-text-target="description" focus-text-lang="SING_EXIT_DESC"><svg src="button.svg" /><span lang="SING_EXIT" /></button>
  <svg class="footer" src="footer.svg" />
  <div class="footer-labels"><template src="footer-main" /></div>
  <div class="reflection-clip"><div class="footer-labels"><template src="footer-main" /></div></div>
  </div>
</body>
</rml>
