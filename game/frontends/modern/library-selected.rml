<template name="library-selected"><head></head><body><div class="selected-artist" fit-text="1.5">{{ data.library.artist }}</div><div class="selected-title" fit-text="1.5">{{ data.library.title }}</div><div class="selected-year">{{ data.library.year }}</div><img class="selected-video" data-class-hidden="!data.library.video" src="../../themes/Modern/[icon]song_video.png"/><img class="selected-duet" data-class-hidden="!data.library.duet" src="../../themes/Modern/[icon]song_duet.png"/><span class="selected-count">{{ data.library.position }}/{{ data.library.total }}</span></body></template>
