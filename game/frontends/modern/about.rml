<rml>
<head>
  <title>About USCE</title>
  <link type="text/rcss" href="modern.rcss" />
  <link type="text/template" href="footer-about.rml" />
</head>
<body class="settings-form about-screen">
  <svg class="background-edge" src="edge-main.svg" />
  <img class="background" src="../../themes/Modern/[bg-main]blue.jpg" />
  <div class="foreground">
    <img class="heading-icon" src="../../themes/Modern/[icon]main.png" />
    <span class="heading" lang="ABOUT_MAIN" />
    <span class="description" lang="ABOUT_MAIN_DESC" />
    <div class="about-panel"><div class="about-panel-top" /><div class="about-panel-bottom" /></div>
    <div class="about-text" bind-lines="about.text" />
    <button class="about-credits" action="credits.open"><svg src="button.svg" /><span lang="ABOUT_USDX_CREDITS" /></button>
    <button class="about-back" action="navigation.back"><svg src="button.svg" /><span lang="SING_OPTIONS_EXIT" /></button>
    <svg class="footer" src="footer.svg" />
    <div class="footer-labels"><template src="footer-about" /></div>
    <div class="reflection-clip"><div class="footer-labels"><template src="footer-about" /></div></div>
  </div>
</body>
</rml>
