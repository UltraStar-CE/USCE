<template name="settings-form" content="form-components">
<head>
  <title>Modern settings form</title>
  <link type="text/rcss" href="modern.rcss" />
  <link type="text/template" href="footer-form.rml" />
</head>
<body class="settings-form">
  <svg class="background-edge" src="edge-main.svg" />
  <img class="background" src="../../themes/Modern/[bg-main]blue.jpg" />
  <div data-model="game">
  <div class="foreground" data-class-preview="data.form.preview">
    <img class="heading-icon" src="../../themes/Modern/[icon]options.png" />
    <span class="heading" lang="SING_OPTIONS" />
    <span class="description" bind-text="form.description" />
    <div class="form-area">
      <div class="form-fields">
        <div data-for="field : data.form.fields" class="form-row" data-attr-id="'form-row-' + field.id" data-class-hidden="!field.visible" data-class-inline="field.inline" data-class-selected="field.selected" data-class-section="field.kind == 2" data-class-command="field.kind == 1">
          <button class="form-label" action="form.activate" data-attr-id="'field-' + field.id" data-attr-target="field.id"><span>{{ field.label }}</span></button>
          <div class="form-value">
            <button class="form-previous" action="form.decrement" data-attr-target="field.id" data-class-available="field.previous"><svg src="arrow-left.svg" /></button>
            <button class="form-current" action="form.activate" data-attr-target="field.id"><span>{{ field.value }}</span></button>
            <button class="form-next" action="form.increment" data-attr-target="field.id" data-class-available="field.next"><svg src="arrow-right.svg" /></button>
          </div>
          <div class="form-choices">
            <button data-for="choice : field.choices" action="form.choose" data-attr-target="choice.target" data-class-chosen="choice.selected"><span>{{ choice.label }}</span></button>
          </div>
          <div class="form-surface" data-attr-id="'field-surface-' + field.id" />
        </div>
      </div>
      <button id="form-back" class="form-back" action="navigation.back" data-class-selected="data.form.backSelected"><span lang="SING_OPTIONS_EXIT" /></button>
      <div class="form-back-reflection" data-class-selected="data.form.backSelected" />
    </div>
    <div id="form-components" />
    <svg class="footer" src="footer.svg" />
    <div class="footer-labels"><template src="footer-form" /></div>
    <div class="reflection-clip"><div class="footer-labels"><template src="footer-form" /></div></div>
  </div>
  </div>
</body>
</template>
