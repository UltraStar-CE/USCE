<rml><head><title>Modern song library</title>
<link type="text/rcss" href="modern.rcss" /><link type="text/rcss" href="library.rcss" />
<link type="text/template" href="library-footer.rml"/><link type="text/template" href="library-selected.rml"/></head><body class="library-screen"><div class="background-layer"><div class="background-edge background-edge-left"/><div class="background"/><div class="background-edge background-edge-right"/></div>
<div data-model="game"><div class="foreground" data-attr-class="'foreground library-' + data.library.layout">
<img class="library-icon" src="../../themes/Modern/[icon]cd.png"/><span class="library-heading" lang="SING_SONG_SELECTION"/>
<div class="library-category">{{ data.library.category }}</div>
<div id="library-window" class="library-window"><div id="library-measure" class="library-measure"/>
<div data-for="song : data.library.songs" class="song-slot" data-class-selected="song.id == data.library.selected" data-style-left="data.library.layout == 'roulette' ? (37.5 + 25 * (((song.relative * 3.141592653589793 / (data.library.total | min(5) | max(1))) * 1.3) | sin) * 1.44 - (25 * (((song.relative * 3.141592653589793 / (data.library.total | min(5) | max(1))) * 0.8) | cos) - 25) / 2) + 'vw' : song.column + '%'" data-style-top="data.library.layout == 'roulette' ? (20 + 33.333333 * (1 - ((song.relative * 3.141592653589793 / (data.library.total | min(5) | max(1))) | cos)) / 2 - (25 * data.library.aspect - 33.333333) * (((song.relative * 3.141592653589793 / (data.library.total | min(5) | max(1))) * 0.8) | cos)) + 'vh' : song.row + '%'" data-style-width="data.library.layout == 'roulette' ? (25 * (((song.relative * 3.141592653589793 / (data.library.total | min(5) | max(1))) * 0.8) | cos)) + 'vw' : (data.library.layout == 'chessboard' ? '20%' : '100%')" data-style-height="data.library.layout == 'roulette' ? (25 * (((song.relative * 3.141592653589793 / (data.library.total | min(5) | max(1))) * 0.8) | cos)) + 'vw' : (data.library.layout == 'chessboard' ? '33.333333%' : '20%')" data-style-opacity="data.library.layout == 'roulette' ? (data.library.total &lt; 5 ? (1 - (song.relative | abs) / (data.library.total | max(1)) * 2) : 1) : 1" data-style-z-index="data.library.layout == 'roulette' ? (100 - ((song.relative | abs) * 10)) : 0">
<button class="song-card" data-attr-id="'library-song-' + song.id" action="library.activate" data-attr-target="song.id" data-attr-focus-target="song.id">
<div class="song-cover" data-style-opacity="data.library.layout == 'roulette' &amp;&amp; song.id == data.library.selected ? (1 - data.library.previewAlpha) : 1" data-style-decorator="'image(&quot;' + song.cover + '&quot; cover)'"/><div class="song-reflection-clip"><div class="song-reflection" data-style-opacity="song.id == data.library.selected ? (1 - data.library.previewAlpha) : 1" data-style-decorator="'image(&quot;' + song.cover + '&quot; cover)'"/></div><span class="song-artist">{{ song.artist }}</span><span class="song-title">{{ song.title }}</span><span class="song-year">{{ song.year != '' ? '(' + song.year + ')' : '' }}</span>
<img class="song-video" data-class-hidden="!song.video" src="../../themes/Modern/[icon]song_video.png"/><img class="song-duet" data-class-hidden="!song.duet" src="../../themes/Modern/[icon]song_duet.png"/>
</button></div></div>
<div class="selected-song participant-name"><template src="library-selected"/></div><div class="selected-panel-reflection-clip"><div class="selected-panel-reflection participant-name"><template src="library-selected"/></div></div>
<div id="library-preview" class="library-preview"><div class="selected-cover" data-style-opacity="1 - data.library.previewAlpha" data-style-decorator="data.library.cover != '' ? 'image(&quot;' + data.library.cover + '&quot; cover)' : 'none'"/></div>
<button class="library-previous" action="library.previous"><svg src="arrow-left.svg"/></button><button class="library-next" action="library.next"><svg src="arrow-right.svg"/></button><div id="library-preview-reflection" class="library-preview-reflection"/><div class="voices"><button data-for="player : data.library.players" class="voice" data-attr-id="'library-voice-' + player.id" focus-target="voice" action="library.voice.next" data-attr-target="player.id" data-style-background-color="player.tint"><span>{{ player.voice }}</span></button></div>
<div class="library-scores" data-class-hidden="data.library.scores.size == 0"><span class="score-label-best" lang="SONG_SCORE_MAX"/><span class="score-label-average" lang="SONG_SCORE_MEDIA"/>
<div data-for="score : data.library.scores" class="library-score" data-class-local="score.source == ''" data-class-web="score.source != ''"><span class="score-source description">{{ score.source }}</span><span class="score-best">{{ score.best }}</span><span class="score-singer description">{{ score.singer }}</span><span class="score-average">{{ score.average }}</span></div></div>
<div class="library-teams" data-class-hidden="!data.library.party"><div data-for="team : data.library.teams"><span>{{ team.name }}</span><button data-attr-id="'library-joker-' + team.id" action="library.joker" data-attr-target="team.id">{{ team.jokers }}</button></div></div>
<div class="library-medley" data-class-hidden="!data.library.medley"><div data-for="song : data.library.medleySongs">{{ song.number }} {{ song.artist }} - {{ song.title }}</div></div>
<div class="library-empty" data-class-hidden="!data.library.empty"><span lang="SONG_JUMPTO_NOSONGSFOUND"/></div>
<div id="library-spectrum" class="library-spectrum" data-class-hidden="!data.library.previewPlaying"><div id="library-spectrum-cell" class="library-spectrum-cell"/><div data-for="band : data.library.spectrum" class="spectrum-band" data-style-width="(70 / (data.library.spectrumCount | max(1))) + '%'" data-style-left="(band.index * 100 / (data.library.spectrumCount | max(1))) + '%'" data-style-height="(band.level * 100) + '%'"/></div>
<div class="library-count">{{ data.library.position }} / {{ data.library.total }}</div>
<div class="library-continuous" data-class-hidden="!data.library.continuous"><img src="../../themes/Modern/[song]continuous.png"/></div>
<div class="library-message">{{ data.library.message }}</div>
<div class="footer"/><div class="footer-labels"><template src="library-footer"/></div><div class="reflection-clip"><div class="footer-labels"><template src="library-footer"/></div></div></div></div></body></rml>