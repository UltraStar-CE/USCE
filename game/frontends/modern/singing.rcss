/* Modern singing HUD. Every player and specialized canvas is positioned by this theme. */
.singing-screen, .singing-stage, #singing-video, .players { position: absolute; left: 0; top: 0; width: 100vw; height: 100vh; }
.singing-screen { background-color: transparent; }
.singing-screen .background-layer { display: block; pointer-events: none; }
.singing-screen .foreground { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.singing-screen .hidden { display: none; }
.foreground-only .background-layer { visibility: hidden; }
.singing-screen button { background-color: transparent; color: white; padding: 0; border: 0; }
.players { display: flex; flex-direction: column; flex-wrap: wrap; }
.player-slot { position: relative; flex-shrink: 0; }
.player-slot, .player-slot .foreground { pointer-events: none; }
.player-header, .player-name, .score-card, .score-bars, .note-lane, .input-surface, .note-guide, .note-anchor, .note-size, .rating-notices { position: absolute; }
.player-frame { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.player-avatar { position: absolute; left: 10%; top: 10%; width: 80%; height: 80%; }
.player-name { color: white; font-weight: bold; white-space: nowrap; overflow: hidden; }
.score-card, .score-bars, .rating-bar, .remaining-bar, .time-segment, .time-progress { display: block; }
.score-card img { position: absolute; width: 100%; height: 100%; }
.score-value { transform-origin: 0 0; position: absolute; left: 18%; top: 5.555556%; width: 82%; height: 88%; white-space: nowrap; }
.rating-bar, .remaining-bar { position: relative; width: 100%; height: 50%; background-color: #ffffff30; overflow: hidden; }
.rating-value, .remaining-value, .potential { position: absolute; left: 0; top: 0; height: 100%; transition: width 0.15s; }
.potential { background-color: #ffffff66; }
.score-bars.mode-2 .remaining-bar, .score-bars.mode-3 .rating-bar { display: none; }
.score-bars.mode-2 .rating-bar, .score-bars.mode-3 .remaining-bar { height: 100%; }
.note-guide { left: 0; top: 0; width: 100%; height: 100%; }
.note-anchor { left: 0; top: 77.777778%; width: 100%; height: 1px; }
.note-size { left: 0; top: 0; }
.rating-notice { position: absolute; left: 0; top: 0; width: 100%; height: 5vh; text-align: center; font-size: 2.25vh; font-weight: bold; }
.rating-notice img { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.rating-notice span { position: relative; top: 20%; }
.solo-lyrics-back, .upper-lyrics-back, .lower-lyrics-back { position: absolute; left: 1.25vw; width: 97.5vw; }
.solo-lyrics-back { top: 82vh; height: 14.166667vh; }
.upper-lyrics-back { top: 0.833333vh; height: 14.166667vh; }
.lower-lyrics-back { top: 82vh; height: 14.166667vh; }
.solo-lyrics-back img, .upper-lyrics-back img, .lower-lyrics-back img { width: 100%; height: 100%; }
#singing-lyrics-upper, #singing-lyrics-lower { position: absolute; left: 10vw; width: 80vw; height: 6.833333vh; }
#singing-lyrics-upper { top: 82.166667vh; }
#singing-lyrics-lower { top: 89.166667vh; }
.voice-bank { position: absolute; left: 10vw; width: 80vw; height: 13.666667vh; display: flex; flex-wrap: wrap; }
.upper-voices { top: 1.166667vh; }
.lower-voices { top: 82.166667vh; }
.voice-cell { position: relative; }
.voice-surface { position: absolute; left: 3vw; top: 0; right: 1vw; height: 100%; }
.voice-bank .voice-cell .voice-label { position: absolute; left: 0; top: 0; width: 4vw; height: 100%; font-size: 1.5vh; font-weight: normal; }
.timebar { position: absolute; left: 1.25vw; top: 96.166667vh; width: 97.5vw; height: 3.333333vh; }
.timebar > img { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.time-label, .time-clock { position: absolute; top: 0; height: 100%; font-size: 2.25vh; font-weight: bold; }
.time-label { left: 0; width: 8.25vw; }
.time-clock { left: 88.75vw; width: 10vw; }
#singing-progress { position: absolute; left: 9.625vw; top: 1.166667vh; width: 79.125vw; height: 1vh; overflow: hidden; }
.time-segment, .time-progress { position: absolute; top: 0; height: 100%; }
.time-segment { opacity: 0.6; }
.time-segment { background-color: #ffff00; }
.time-progress { left: 0; background-color: #ffffffcc; }
.message { position: absolute; left: 31.25vw; top: 6.666667vh; width: 37.5vw; height: 4.166667vh; text-align: center; background-color: #444444dd; color: white; font-weight: bold; font-size: 2.5vh; }
.song-title { position: absolute; left: 1.25vw; top: 1.666667vh; width: 97.5vw; height: 4.833333vh; color: black; background-color: #ffffffdd; text-align: center; font-size: 3.125vh; }
.countdown { position: absolute; left: 50vw; top: 50vh; font-size: 12vh; font-weight: bold; color: white; }
.pause { position: absolute; left: 37.5vw; top: 40vh; width: 25vw; height: 20vh; }
.pause img { width: 100%; height: 100%; }
