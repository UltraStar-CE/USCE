/* All menu variants share semantic slots; the theme controls their placement. */
.song-menu-screen { overflow: hidden; background-color: transparent; }
.song-menu-shade { position: absolute; left: 0; top: 0; width: 100vw; height: 100vh; background-color: #0000004d; }
.song-menu-panel { position: absolute; left: 62.5vw; top: 20vh; width: 35vw; height: 33.333333vh; decorator: image("../../themes/Modern/[interface]dialog_backgroundtop.png"); }
.song-menu-icon { position: absolute; left: 2.5vw; margin-left: -2vh; top: 2.5vh; width: 4vh; height: 4vh; }
.song-menu-heading { color: #87d3fb; position: absolute; left: 4.75vw; top: 1.5vh; width: 29vw; height: 7vh; font-size: 4.5vh; white-space: nowrap; overflow: hidden; }
.song-menu-entry { display: block; min-height: 0; margin: 0; padding: 0; position: absolute; left: 3.75vw; top: 9.666667vh; width: 27.5vw; height: 4.166667vh; font-size: 3vh; }
.song-menu-entry[slot="1"] { top: 14.166667vh; }
.song-menu-entry[slot="2"] { top: 18.666667vh; }
.song-menu-entry[slot="3"] { top: 23.166667vh; }
.song-menu-entry[slot="4"] { top: 27.666667vh; }
.song-menu-entry .entry-action, .song-menu-entry .entry-choice { position: absolute; left: 0; top: 0; width: 100%; height: 100%; min-height: 0; margin: 0; padding: 0; display: block; font-size: 3vh; }
.song-menu-entry .entry-action { text-align: left; }
.song-menu-entry .entry-action > span { position: absolute; display: block; left: 0.75vw; right: 0.75vw; top: 0; height: 100%; margin: 0; line-height: 4.166667vh; white-space: nowrap; overflow: hidden; }
.song-menu-entry .entry-choice button { position: absolute; top: 0; height: 100%; background-color: transparent; font-size: 3vh; }
.entry-previous { left: 0; width: 2.5vw; }
.entry-next { right: 0; width: 2.5vw; }
.entry-value { left: 2.5vw; width: 22.5vw; }
.entry-value span { position: absolute; left: 0; top: 0; width: 100%; height: 100%; margin: 0; display: block; line-height: 4.166667vh; white-space: nowrap; overflow: hidden; }
.entry-previous svg, .entry-next svg { opacity: 1; }
.song-menu-entry .entry-caret { position: relative; display: inline; left: 0; top: 0; margin: 0; opacity: 0.5; }
.song-menu-entry.disabled { opacity: 1; }
.song-menu-entry.disabled button, .song-menu-entry .unavailable { pointer-events: none; }
.song-menu-entry .unavailable { opacity: 0; }
.song-menu-entry.selected .entry-action span, .song-menu-entry.selected .entry-value span { font-weight: bold; }
.song-menu-screen .hidden { display: none; }

/* Native song-menu commands paint only the selected row. Scope these above
   generic form and palette selectors; the panel supplies inactive backgrounds. */
.song-menu-screen .song-menu-entry .entry-action,
.song-menu-screen .song-menu-entry .entry-choice,
.song-menu-screen .song-menu-entry .entry-choice button { background-color: transparent; }
.song-menu-screen .song-menu-entry.selected .entry-action,
.song-menu-screen .song-menu-entry.selected .entry-choice { background-color: #00a8fee6; }
