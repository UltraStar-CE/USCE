/* Player setup layout belongs to the theme, including compact player grids. */
.players-screen .heading { top: 0.833333vh; }
.players-screen .heading-icon { top: 3.666667vh; }
.players-screen .description { top: 10vh; }
.players-screen .where { font-size: 2.25vh; }
.player-count { position: absolute; left: 11.25vw; top: 21.666667vh; width: 77.5vw; height: 5.833333vh; display: flex; }
.count-label { width: 31.25vw; height: 100%; font-size: 3.75vh; text-align: left; padding-left: 2.5vw; }
.count-label span { margin-top: 0.5vh; }
.count-value { display: flex; margin-left: 1.25vw; width: 45vw; height: 100%; background-color: #42a3e7e6; }
.count-value button { background-color: transparent; height: 100%; font-size: 3.75vh; }
.count-value span { margin-top: 0.5vh; }
.previous, .next { width: 2.5vw; height: 100%; flex-shrink: 0; }
.previous svg, .next svg, .avatar-previous svg, .avatar-next svg { opacity: 1; }
.current { flex: 1; }
.unavailable { visibility: hidden; }
.profiles { position: absolute; left: 3.75vw; top: 30.833333vh; width: 95vw; height: 25.833333vh; display: flex; flex-wrap: wrap; align-content: flex-start; }
.profile-slot { width: 50%; height: 100%; }
.profile { position: relative; left: 50%; width: 22.1875vw; height: 22.5vh; margin: 0; transform: translateX(-50%); transform-origin: 50% 0%; background-color: transparent; }
.profile:hover, .profile:focus { background-color: transparent; }
.profile-frame { position: absolute; left: 3.825vw; top: 0; width: 15.833333vh; height: 13.5vh; }
.profile-avatar { position: absolute; left: 4.40625vw; top: 1.125vh; width: 13.751111vh; height: 11.805vh; }
.profile-name, .profile-name-reflection { position: absolute; left: -3vw; top: 13.725vh; width: 100%; height: 3.6vh; font-size: 2.75vh; font-weight: bold; white-space: nowrap; overflow: hidden; }
.profile-name-reflection { top: 17.325vh; transform: scaleY(-1); opacity: 0.3; mask-image: vertical-gradient(#0000 #0008); }
.avatar-frame { position: absolute; left: 38.25vw; top: 45.833333vh; width: 24.75vw; height: 27.333333vh; background-color: transparent; }
.avatar-frame img { position: absolute; left: 50%; top: 0; width: 33vh; height: 27.333333vh; transform: translateX(-50%); pointer-events: none; }
.avatar-frame:focus, .avatar-frame:hover { background-color: transparent; }
.avatar-carousel { position: absolute; left: 0; top: 0; width: 100%; height: 100%; pointer-events: none; }
.avatar-slot { position: absolute; left: 50vw; top: 60vh; width: 0; height: 0; opacity: 0; }
.avatar-image { width: 100%; height: 100%; }
.avatar-previous, .avatar-next { position: absolute; top: 56.666667vh; width: 2.5vw; height: 5vh; background-color: transparent; }
.avatar-previous { left: 41.25vw; } .avatar-next { left: 57.5vw; }
.name-entry { position: absolute; left: 33.125vw; top: 73.333333vh; width: 33.75vw; height: 5.833333vh; font-size: 3.25vh; }
.profile-choice { position: absolute; left: 35.625vw; width: 28.75vw; height: 3.333333vh; display: flex; }
.profile-choice button { height: 100%; background-color: transparent; font-size: 2.25vh; }
.profile-choice span { margin-top: 0.166667vh; }
.color-choice { top: 79.666667vh; } .level-choice { top: 83.333333vh; } .voice-choice { top: 87vh; }
.players-screen .hidden { display: none; }
.players-screen .name-icon { left: 52vw; } .players-screen .name-legend { left: 55vw; }
.players-screen .continue-icon { left: 75.75vw; } .players-screen .continue-legend { left: 78.75vw; }
.name-text { display: flex; justify-content: center; width: 100%; height: 4vh; margin-top: 0.833333vh; white-space: nowrap; overflow: hidden; }
.name-entry .name-text span { display: block; position: relative; width: auto; flex-shrink: 0; margin: 0; }
.name-entry:focus .name-text { font-weight: bold; }
.name-text .suggested-name { opacity: 0.5; }
.avatar-image-button { width: 100%; height: 100%; background-color: transparent; pointer-events: auto; }
.avatar-image-button:hover, .avatar-image-button:focus { background-color: transparent; }
.avatar-image { pointer-events: none; }
.avatar-slot[slot="0"] .avatar-image, .avatar-slot[slot="1"] .avatar-image, .avatar-slot[slot="3"] .avatar-image, .avatar-slot[slot="4"] .avatar-image { filter: brightness(0.7); }
.count-1 .profile-slot { width: 50.000000%; height: 100%; }
.count-1 .profile { transform: translateX(-50%) scale(1.000000); }
.count-2 .profile-slot { width: 50.000000%; height: 100%; }
.count-2 .profile { transform: translateX(-50%) scale(1.000000); }
.count-3 .profile-slot { width: 33.333333%; height: 100%; }
.count-3 .profile { transform: translateX(-50%) scale(0.851852); }
.count-4 .profile-slot { width: 25.000000%; height: 100%; }
.count-4 .profile { transform: translateX(-50%) scale(0.851852); }
.count-5 .profile-slot { width: 20.000000%; height: 100%; }
.count-5 .profile { transform: translateX(-50%) scale(0.740741); }
.count-6 .profile-slot { width: 16.666667%; height: 100%; }
.count-6 .profile { transform: translateX(-50%) scale(0.740741); }
.count-7 .profile-slot { width: 14.285714%; height: 100%; }
.count-7 .profile { transform: translateX(-50%) scale(0.740741); }
.count-8 .profile-slot { width: 12.500000%; height: 100%; }
.count-8 .profile { transform: translateX(-50%) scale(0.670194); }
.count-9 .profile-slot { width: 11.111111%; height: 100%; }
.count-9 .profile { transform: translateX(-50%) scale(0.595728); }
.count-10 .profile-slot { width: 10.000000%; height: 100%; }
.count-10 .profile { transform: translateX(-50%) scale(0.536155); }
.count-11 .profile-slot { width: 9.090909%; height: 100%; }
.count-11 .profile { transform: translateX(-50%) scale(0.487414); }
.count-12 .profile-slot { width: 8.333333%; height: 100%; }
.count-12 .profile { transform: translateX(-50%) scale(0.446796); }
.count-13 .profile-slot { width: 8.333333%; height: 33.333333%; }
.count-13 .profile { transform: translateX(-50%) scale(0.446796); }
.count-14 .profile-slot { width: 8.333333%; height: 33.333333%; }
.count-14 .profile { transform: translateX(-50%) scale(0.446796); }
.count-15 .profile-slot { width: 8.333333%; height: 33.333333%; }
.count-15 .profile { transform: translateX(-50%) scale(0.446796); }
.count-16 .profile-slot { width: 8.333333%; height: 33.333333%; }
.count-16 .profile { transform: translateX(-50%) scale(0.446796); }
.count-17 .profile-slot { width: 8.333333%; height: 33.333333%; }
.count-17 .profile { transform: translateX(-50%) scale(0.446796); }
.count-18 .profile-slot { width: 8.333333%; height: 33.333333%; }
.count-18 .profile { transform: translateX(-50%) scale(0.446796); }
.count-19 .profile-slot { width: 8.333333%; height: 33.333333%; }
.count-19 .profile { transform: translateX(-50%) scale(0.446796); }
.count-20 .profile-slot { width: 8.333333%; height: 33.333333%; }
.count-20 .profile { transform: translateX(-50%) scale(0.446796); }
.count-21 .profile-slot { width: 8.333333%; height: 33.333333%; }
.count-21 .profile { transform: translateX(-50%) scale(0.446796); }
.count-22 .profile-slot { width: 8.333333%; height: 33.333333%; }
.count-22 .profile { transform: translateX(-50%) scale(0.446796); }
.count-23 .profile-slot { width: 8.333333%; height: 33.333333%; }
.count-23 .profile { transform: translateX(-50%) scale(0.446796); }
.count-24 .profile-slot { width: 8.333333%; height: 33.333333%; }
.count-24 .profile { transform: translateX(-50%) scale(0.446796); }

.player-count.selected .count-label { font-weight: bold; background-color: #7ec5eae6; }
/* Avatar centers follow the original carousel; sizes use the uniform viewport scale. */
.avatar-reflection-clip { position: absolute; left: 0; top: 100%; margin-top: 0.333333vh; width: 100%; height: 50%; overflow: hidden; mask-image: vertical-gradient(#000000b3 #0000); pointer-events: none; }
.avatar-reflection { position: absolute; left: 0; top: 0; width: 100%; height: 200%; transform: scaleY(-1); }
.avatar-slot[slot="0"] .avatar-reflection, .avatar-slot[slot="1"] .avatar-reflection, .avatar-slot[slot="3"] .avatar-reflection, .avatar-slot[slot="4"] .avatar-reflection { filter: brightness(0.7); }
.name-entry, .profile-choice { z-index: 4; }
.name-entry .name-text .name-caret { width: 0; overflow: visible; animation: 1.1s name-caret infinite; }
@keyframes name-caret { from { opacity: 1; } 49% { opacity: 1; } 50% { opacity: 0; } to { opacity: 0; } }
.avatar-slot[slot="0"] { left: 24.663336vw; top: 61.896963vh; width: 11.252363vh; height: 10.537927vh; transform: translate(-50%, -50%); z-index: 1; opacity: 1; }
.avatar-slot[slot="1"] { left: 31.594946vw; top: 60.328349vh; width: 18.402440vh; height: 17.234031vh; transform: translate(-50%, -50%); z-index: 2; opacity: 1; }
.avatar-slot[slot="2"] { left: 50.375000vw; top: 59.666667vh; width: 21.000000vh; height: 19.666667vh; transform: translate(-50%, -50%); z-index: 3; opacity: 1; }
.avatar-slot[slot="3"] { left: 69.155054vw; top: 60.328349vh; width: 18.402440vh; height: 17.234031vh; transform: translate(-50%, -50%); z-index: 2; opacity: 1; }
.avatar-slot[slot="4"] { left: 76.086664vw; top: 61.896963vh; width: 11.252363vh; height: 10.537927vh; transform: translate(-50%, -50%); z-index: 1; opacity: 1; }
@media (max-aspect-ratio: 4/3) {
  .avatar-slot[slot="0"] { width: 8.439272vw; height: 7.903445vw; }
  .avatar-slot[slot="1"] { width: 13.801830vw; height: 12.925524vw; }
  .avatar-slot[slot="2"] { width: 15.750000vw; height: 14.750000vw; }
  .avatar-slot[slot="3"] { width: 13.801830vw; height: 12.925524vw; }
  .avatar-slot[slot="4"] { width: 8.439272vw; height: 7.903445vw; }
}

/* Stable item identities let CSS animate the carousel without game-side geometry. */
.avatar-slot { transition: left top width height opacity 0.9s exponential-out; }
.avatar-slot.offstage-left, .avatar-slot.offstage-right { display: none; }
.avatar-slot[slot="-1"] { left: 20vw; top: 64vh; width: 7vh; height: 6.5vh; transform: translate(-50%, -50%); opacity: 0; pointer-events: none; }
.avatar-slot[slot="5"] { left: 80vw; top: 64vh; width: 7vh; height: 6.5vh; transform: translate(-50%, -50%); opacity: 0; pointer-events: none; }

.player-count.selected .count-value { background-color: #7ec5eae6; font-weight: bold; }
.profile-choice.selected .current span { font-weight: bold; }

.name-entry .name-text .name-caret.hidden { display: none; }
