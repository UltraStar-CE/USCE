<rml><head><title>Modern singing stage</title><link type="text/rcss" href="modern.rcss" /><link type="text/rcss" href="singing.rcss" /></head>
<body class="singing-screen"><div data-model="game" data-attr-class="'singing-stage count-' + data.singing.count + (data.singing.duet ? ' mode-duet' : ' mode-solo')">
  <div id="singing-video" />
  <div class="background-layer">
    <div class="solo-lyrics-back" data-class-hidden="data.singing.duet || !data.singing.lyrics || !data.singing.soloText"><img src="../../themes/Modern/[sing]textBar.png" /></div>
    <div class="upper-lyrics-back" data-class-hidden="!data.singing.duet || !data.singing.lyrics || !data.singing.upperText"><img src="../../themes/Modern/[sing]textBarDuet.png" /></div>
    <div class="lower-lyrics-back" data-class-hidden="!data.singing.duet || !data.singing.lyrics || !data.singing.lowerText"><img src="../../themes/Modern/[sing]textBarDuet.png" /></div>
  </div>
  <div class="players">
    <div data-for="player : data.singing.players" class="player-slot" data-attr-class="'player-slot level-' + player.level">
      <div data-attr-id="'singing-notes-' + player.id" class="note-lane"><div data-attr-id="'singing-guide-' + player.id" class="note-guide" /><div data-attr-id="'singing-note-anchor-' + player.id" class="note-anchor" /><div data-attr-id="'singing-note-size-' + player.id" class="note-size" /></div>
      <div data-attr-id="'singing-input-' + player.id" class="input-surface" />
      <div data-attr-id="'singing-player-header-' + player.id" class="player-header header-measure" data-style-transform="'scale(' + ((1 / (data.singing.aspect ? data.singing.aspect : 1)) | min(1)) + ',' + ((data.singing.aspect ? data.singing.aspect : 1) | min(1)) + ')'" />
      <div class="foreground">
        <div class="player-header" data-style-transform="'scale(' + ((1 / (data.singing.aspect ? data.singing.aspect : 1)) | min(1)) + ',' + ((data.singing.aspect ? data.singing.aspect : 1) | min(1)) + ')'" data-class-hidden="!data.singing.avatars"><img class="player-avatar" data-attr-src="player.avatar" data-style-image-color="player.avatarTint" /><img class="player-frame" src="../../themes/Modern/[score]frame.png" data-style-image-color="player.color" /></div>
        <span class="player-name" data-class-hidden="!data.singing.avatars">{{ player.name }}</span>
        <div class="score-card" data-style-transform="'scale(' + ((1 / (data.singing.aspect ? data.singing.aspect : 1)) | min(1)) + ',' + ((data.singing.aspect ? data.singing.aspect : 1) | min(1)) + ')'" data-class-hidden="!data.singing.scores || !player.enabled || data.singing.scoreMode == 0"><img src="score-card.svg" data-style-image-color="player.color" /><span class="score-value" data-style-transform="'scale(' + ((data.singing.aspect ? data.singing.aspect : 1) | max(1)) + ',' + ((1 / (data.singing.aspect ? data.singing.aspect : 1)) | max(1)) + ')'">{{ player.scoreText }}</span></div>
        <div class="score-bars" data-style-transform="'scale(' + ((1 / (data.singing.aspect ? data.singing.aspect : 1)) | min(1)) + ',' + ((data.singing.aspect ? data.singing.aspect : 1) | min(1)) + ')'" data-attr-class="'score-bars mode-' + data.singing.scoreMode" data-class-hidden="!data.singing.scores || !data.singing.bars || !player.barsVisible || !player.enabled || data.singing.scoreMode == 0">
          <div class="rating-bar"><div class="rating-value" data-style-width="player.rating * 100 + '%'" data-style-background-color="player.rating &lt;= 0.22 ? '#ff0000' : (player.rating &lt;= 0.42 ? 'rgb(255,' + ((player.rating * 1275) | min(255)) + ',0)' : (player.rating &lt;= 0.57 ? '#ffff00' : (player.rating &lt;= 0.77 ? 'rgb(' + (((1 - (player.rating - 0.57) * 5) * 255) | max(0)) + ',255,0)' : '#00ff00')))" /></div>
          <div class="remaining-bar"><div class="potential" data-style-width="player.potential * 100 + '%'" /><div class="remaining-value" data-style-width="(((player.displayedScore + player.pendingScore) / 10000) | max(0) | min(player.potential)) * 100 + '%'" data-style-background-color="player.potential * 10000 >= player.best || player.best == 0 ? '#00ff00' : (player.average > 0 &amp;&amp; player.potential * 10000 &lt; player.average ? '#ff0000' : '#ffff00')" /></div>
        </div>
        <div class="rating-notices" data-class-hidden="!data.singing.ratingFeedback"><div data-for="notice : data.singing.notices" class="rating-notice" data-class-hidden="notice.player != player.id || !player.enabled" data-style-opacity="1 - notice.age / (notice.lifetime | max(0.001))" data-style-transform="'translateY(' + (0 - notice.age * 6) + 'vh)'"><img src="../../themes/Modern/[sing]lineBonusPopUp.png" data-style-image-color="notice.rating &lt; 4 ? '#ff3300' : (notice.rating &lt; 7 ? '#ffff00' : '#00ff00')" /><span data-attr-lang="notice.label" /></div></div>
      </div>
    </div>
  </div>
  <div class="solo-lyric-surfaces"><div id="singing-lyrics-upper" /><div id="singing-lyrics-lower" /></div>
  <div class="upper-voices" data-attr-class="'voice-bank upper-voices count-' + data.singing.upperVoicesCount"><div data-for="voice : data.singing.upperVoices" class="voice-cell"><div data-attr-id="'singing-voice-' + voice.id + '-0'" class="voice-surface" /><span class="voice-label foreground" data-style-color="voice.color" data-class-hidden="!data.singing.duet || !data.singing.lyrics">P{{ voice.number }}</span></div></div>
  <div class="lower-voices" data-attr-class="'voice-bank lower-voices count-' + data.singing.lowerVoicesCount"><div data-for="voice : data.singing.lowerVoices" class="voice-cell"><div data-attr-id="'singing-voice-' + voice.id + '-1'" class="voice-surface" /><span class="voice-label foreground" data-style-color="voice.color" data-class-hidden="!data.singing.duet || !data.singing.lyrics">P{{ voice.number }}</span></div></div>
  <div class="foreground hud-overlay">
    <div class="timebar" data-class-hidden="!data.singing.timebar"><img src="../../themes/Modern/[sing]timeBarBG.png" /><button class="time-label" action="singing.time.mode"><span lang="SING_TIME" /></button><button id="singing-progress" action="singing.seek"><div data-for="segment : data.singing.segments" data-attr-id="'singing-segment-' + segment.id" class="time-segment" data-style-background-color="segment.color" data-style-left="(segment.start - data.singing.start) / (data.singing.duration | max(0.001)) * 100 + '%'" data-style-width="(segment.end - segment.start) / (data.singing.duration | max(0.001)) * 100 + '%'"></div><div class="time-progress" data-style-width="data.singing.progress * 100 + '%'" /></button><button class="time-clock" action="singing.time.mode">{{ data.singing.clock }}</button></div>
    <div class="message" data-class-hidden="!data.singing.messageVisible" data-style-opacity="(data.singing.messageAlpha ? data.singing.messageAlpha : 0)">{{ data.singing.message }}</div>
    <div class="song-title" data-class-hidden="!data.singing.titleVisible" data-style-opacity="(data.singing.titleAlpha ? data.singing.titleAlpha : 0)">{{ data.singing.songTitle }}</div>
    <div class="countdown" data-class-hidden="!data.singing.feedback || data.singing.countdown == 0" data-style-opacity="(data.singing.countdownPhase ? data.singing.countdownPhase : 0)" data-style-transform="'translate(-50%, -50%) scale(' + (data.singing.countdownPhase ? data.singing.countdownPhase : 0) + ')'">{{ data.singing.countdown }}</div>
    <button class="pause" action="singing.pause.toggle" data-class-hidden="!data.singing.paused"><img src="../../themes/Modern/[sing]pause.png" /></button>
  </div>
</div></body></rml>
