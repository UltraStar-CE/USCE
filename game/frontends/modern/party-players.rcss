/* Modern's team setup, with names and counts supplied independently of widgets. */
.team-count { position: absolute; left: 8.75vw; top: 18.333333vh; width: 80vw; height: 6.666667vh; display: flex; }
.party-players-screen .team-count { margin-top: 0; margin-left: 0; }
.party-players-screen .count-label { width: 28.75vw; text-align: left; padding-left: 0; }
.party-players-screen .count-label span { margin-left: 2.5vw; }
.party-players-screen .count-value { display: flex; width: 50vw; margin-left: 1.25vw; }
.party-players-screen .count-value button { background-color: transparent; }
.party-players-screen .previous, .party-players-screen .next { width: 2.5vw; flex-shrink: 0; }
.party-players-screen .previous svg, .party-players-screen .next svg { opacity: 1; }
.party-players-screen .current { flex: 1; }
.party-players-screen button { height: 6.666667vh; font-size: 3.75vh; }
.party-players-screen button span { margin-top: 0.666667vh; }
.party-players-screen .selected { font-weight: bold; }
.party-players-screen .unavailable { visibility: hidden; }
.party-players-screen .hidden { display: none; }
.party-teams { position: absolute; left: 8.75vw; top: 29.166667vh; width: 81vw; }
.party-team { display: block; position: relative; width: 81vw; height: 20.833333vh; }
.team-name { position: absolute; left: 0; top: 0; width: 28.75vw; font-size: 4vh; }
.team-player-count { position: absolute; left: 30vw; top: 0; display: flex; width: 50vw; height: 6.666667vh; }
.team-player-count .count-label { width: 25vw; background-color: transparent; }
.team-player-count .count-value { width: 23.75vw; }
.team-count.selected .current, .team-player-count.selected .current { font-weight: bold; }
.team-players { position: absolute; left: 0; top: 8.333333vh; width: 81vw; display: flex; }
.player-slot { width: 20.25vw; flex-shrink: 0; }
.player-name { width: 19.25vw; }
.name-text { display: flex; justify-content: center; width: 100%; height: 5.333333vh; padding-top: 0.666667vh; white-space: nowrap; overflow: hidden; }
.party-players-screen .name-text span { display: block; position: relative; width: auto; flex-shrink: 0; margin-top: 0; }
.name-suggestion { opacity: 0.5; }
.name-reflection { position: relative; top: 0.166667vh; width: 19.25vw; height: 3.333333vh; opacity: 0.7; mask-image: vertical-gradient(#000f #0000); pointer-events: none; }
.party-players-screen .name-icon { left: 50.75vw; }
.party-players-screen .name-legend { left: 53.5vw; }
.party-players-screen .continue-icon { left: 72vw; }
.party-players-screen .continue-legend { left: 74.5vw; }
