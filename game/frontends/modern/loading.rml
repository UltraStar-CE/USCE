<rml>
<head><title>Modern loading</title><link type="text/rcss" href="modern.rcss" /><link type="text/template" href="footer-loading.rml" /></head>
<body class="loading-screen">
  <svg class="background-edge" src="edge-load.svg" />
  <img class="background" src="../../themes/Modern/[bg-load]blue.png" />
  <div class="foreground">
  <svg class="footer" src="footer.svg" />
  <progress class="discovery" bind-value="loading.discovery" value="0" />
  <progress class="loading" bind-value="loading.progress" value="0" />
  <div class="footer-labels"><template src="footer-loading" /></div>
  <div class="reflection-clip"><div class="footer-labels"><template src="footer-loading" /></div></div>
  </div>
</body>
</rml>
