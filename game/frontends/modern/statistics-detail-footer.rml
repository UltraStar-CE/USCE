<template name="statistics-detail-footer"><head></head><body>
  <span class="where" lang="STAT_DETAIL_WHEREAMI" />
  <img class="legend-icon navigation-icon" src="../../themes/Modern/[button]navi.png" />
  <span class="legend navigation" lang="STAT_DETAIL_NAVIGATE" />
  <img class="legend-icon detail-period-icon" src="../../themes/Modern/[button]t.png" />
  <span class="legend detail-period" lang="STAT_PERIOD" />
  <img class="legend-icon detail-median-icon" src="../../themes/Modern/[button]m.png" data-class-hidden="!data.statisticsDetail.medianAvailable" />
  <span class="legend detail-median" lang="STAT_DETAIL_MIN_MEDIAN" data-class-hidden="!data.statisticsDetail.medianAvailable" data-class-filter-active="data.statisticsDetail.medianActive" />
  <img class="legend-icon detail-back-icon" src="../../themes/Modern/[button]esc.png" />
  <span class="legend detail-back" lang="SING_LEGEND_ESC" />
</body></template>
