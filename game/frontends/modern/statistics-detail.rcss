/* Statistics data is raw game state. The table geometry and density are theme-owned. */
.statistics-detail-screen .heading { left: 8.75vw; top: 0.833333vh; font-size: 7.5vh; }
.statistics-detail-screen .heading-icon { left: 5vw; top: 4.166667vh; width: 3.125vw; height: 4.166667vh; }
.statistics-detail-screen .description { left: 8.75vw; top: 10.466667vh; width: 82.5vw; height: 5.833333vh; color: white; white-space: nowrap; overflow: hidden; }
.statistics-detail-screen .where { font-size: 2.25vh; }
.statistics-detail-panel.about-panel { left: 5vw; top: 16.666667vh; width: 90vw; height: 70vh; }
.statistics-detail-panel .about-panel-top { height: 4vh; }
.statistics-detail-panel .about-panel-bottom { height: 3.333333vh; }
.statistics-detail-table { position: absolute; left: 6.875vw; top: 20.666667vh; width: 86.25vw; height: 62.666667vh; font-size: 3vh; }
.statistics-detail-table .table-panel { position: absolute; top: 0; height: 100%; }
.statistics-detail-table .table-header { position: absolute; left: 0; top: -3vh; width: 100%; height: 3vh; color: black; font-weight: bold; font-size: 1.75vh; }
.statistics-detail-table .table-rows { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.statistics-detail-table .table-cell { display: block; position: absolute; top: 0; white-space: nowrap; overflow: hidden; line-height: 1.0; height: 1.25em; }
.statistics-detail-table .numeric { text-align: right; }
.statistics-detail-page { position: absolute; left: 6.875vw; top: 84vh; width: 86.25vw; height: 2.5vh; text-align: right; font-size: 1.875vh; color: black; white-space: nowrap; overflow: hidden; }
.statistics-detail-screen .detail-period-icon { left: 56vw; }
.statistics-detail-screen .detail-period { left: 58.5vw; }
.statistics-detail-screen .detail-median-icon { left: 73.75vw; }
.statistics-detail-screen .detail-median { left: 76.875vw; }
.statistics-detail-screen .detail-back-icon { left: 90.75vw; }
.statistics-detail-screen .detail-back { left: 93.75vw; }
.statistics-detail-screen .filter-active { font-weight: bold; }
.statistics-detail-screen .hidden { display: none; }
.statistics-detail-screen .unavailable { visibility: hidden; }
.statistics-detail-screen .footer-hit { position: absolute; top: 90.833333vh; height: 5vh; background-color: transparent; }
.statistics-detail-screen .page-previous { left: 32vw; width: 2.5vw; }
.statistics-detail-screen .page-next { left: 34.5vw; width: 2.5vw; }
.statistics-detail-screen .entries-fewer { left: 37vw; width: 2.5vw; }
.statistics-detail-screen .entries-more { left: 39.5vw; width: 2.5vw; }
.statistics-detail-screen .period-hit { left: 54vw; width: 17vw; }
.statistics-detail-screen .median-hit { left: 72vw; width: 17vw; }
.statistics-detail-screen .back-hit { left: 89vw; width: 10vw; }
