/* Bracket slot, round and group coordinates belong to this theme. */
.bracket { position: absolute; left: 0; top: 0; width: 100vw; height: 100vh; }
.bracket-player { position: absolute; width: 15vw; height: 5vh; }
.bracket-player[side="0"] { left: 2.5vw; }
.bracket-player[side="1"] { right: 2.5vw; }
.bracket-player button, .bracket-player button:focus { position: absolute; width: 15vw; height: 5vh; padding: 0; border-width: 0; border-radius: 0.8vh; color: white; font-size: 3.333333vh; }
.bracket-player button span { display: block; margin-top: 0.5vh; text-align: center; white-space: nowrap; overflow: hidden; }
.bracket-player:not(.active) { pointer-events: none; }
.bracket-player.eliminated { opacity: 0.1; }
.bracket-player.hidden { display: none; }
.bracket-player.selected button { font-weight: bold; }
.player-marker { position: absolute; left: 15.625vw; top: 0.5vh; font-size: 2vh; color: white; pointer-events: none; }
.bracket-player[side="1"] .player-marker { left: -3.125vw; width: 2.5vw; text-align: right; }
.bracket-node { position: absolute; pointer-events: none; }
.connector-horizontal { position: absolute; left: 0; top: 0; width: 6.25vw; height: 0.833333vh; }
.connector-vertical { position: absolute; left: 6.25vw; top: 0; width: 0.625vw; }
.bracket-node[side="1"] .connector-vertical { left: -0.625vw; }
.bracket-node[phase="3"] .connector-vertical { display: none; }
.bracket-score { position: absolute; font-size: 2vh; color: white; width: 6.25vw; height: 2.5vh; text-align: center; pointer-events: none; }
.trophy { position: absolute; left: 38.75vw; top: 30vh; width: 33.75vw; height: 45vh; pointer-events: none; }
.winner-ribbon { position: absolute; left: 37.5vw; top: 75vh; width: 25vw; height: 13.333333vh; pointer-events: none; }
.tournament-winner { position: absolute; left: 37.5vw; top: 77.5vh; width: 25vw; text-align: center; color: white; font-size: 3.333333vh; pointer-events: none; }
.tournament-continue, .tournament-continue:focus { position: absolute; left: 32vw; top: 93vh; width: 40vw; height: 7vh; background-color: transparent; }
.tournament-continue-icon { left: 34.5vw; }
.tournament-continue-label { left: 37.5vw; }
.bracket-player[slot="0"] { top: 21.666667vh; }
